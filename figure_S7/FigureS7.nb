Cell[CellGroupData[{

Cell["\<\
D. Dispersion across schedules, with and without D-V coupling\
\>", "Section",ExpressionUUID->"9cd581c9-71c6-4c6e-aa52-e26ebc1a7cdc"],

Cell[CellGroupData[{

Cell["\<\
namesD = ToString /@ column[tD, \"schedule\"];
lg[v_List] := Log10[v];
sD = <|\"perI\" -> lg@column[tD, \"period_intact\"], \"perU\" -> \
lg@column[tD, \"period_uncoupled\"],
   \"coupI\" -> lg@column[tD, \"coupling_intact\"], \"coupU\" -> \
lg@column[tD, \"coupling_uncoupled\"]|>;
fixedVar = Log10[constant[\"coupling_adaptive_fixed_variance\"]];
gry = GrayLevel[0.55];
solid[c_] := Directive[c, AbsoluteThickness[0.9]];
dashed[c_] := Directive[c, AbsoluteThickness[0.7], AbsoluteDashing[{2.5, \
1.8}]];
pts[v_] := Transpose[{Range[Length[v]], v}];
keyD = Inset[Grid[{
     {Graphics[{solid[Black], Line[{{-1, 0}, {1, 0}}], dot[{0, 0}, Black]}, \
ImageSize -> {22, 7}, PlotRange -> {{-1, 1}, {-1, 1}}, AspectRatio -> Full], \
txt[\"Period-adaptive\"]},
     {Graphics[{dashed[Black], Line[{{-1, 0}, {1, 0}}], ring[{0, 0}, Black]}, \
ImageSize -> {22, 7}, PlotRange -> {{-1, 1}, {-1, 1}}, AspectRatio -> Full], \
txt[\"uncoupled\"]},
     {Graphics[{solid[gry], Line[{{-1, 0}, {1, 0}}], square[{0, 0}, gry, 2.4, \
True]}, ImageSize -> {22, 7}, PlotRange -> {{-1, 1}, {-1, 1}}, AspectRatio -> \
Full], txt[\"Coupling-adaptive\"]},
     {Graphics[{dashed[gry], Line[{{-1, 0}, {1, 0}}], square[{0, 0}, gry, \
2.4]}, ImageSize -> {22, 7}, PlotRange -> {{-1, 1}, {-1, 1}}, AspectRatio -> \
Full], txt[\"uncoupled\"]}},
    Alignment -> {Left, Center}, Spacings -> {0.3, 0.05}], Scaled[{0.99, \
0.985}], {Right, Top}];
pD = Graphics[{
    {GrayLevel[0.6], AbsoluteThickness[0.5], AbsoluteDashing[{1, 2}], \
Line[{{0.6, fixedVar}, {8.4, fixedVar}}]},
    {solid[gry], Line[pts[sD[\"coupI\"]]]}, {dashed[gry], Line[pts[sD[\"coupU\
\"]]]},
    {solid[Black], Line[pts[sD[\"perI\"]]]}, {dashed[Black], \
Line[pts[sD[\"perU\"]]]},
    square[#, gry, 2.4, True] & /@ pts[sD[\"coupI\"]], square[#, gry, 2.4] & \
/@ pts[sD[\"coupU\"]],
    dot[#, Black] & /@ pts[sD[\"perI\"]], ring[#, Black] & /@ \
pts[sD[\"perU\"]],
    Text[txt[\"Photoperiod\", GrayLevel[0.35]], Scaled[{0.25, -0.2}], {0, \
0}],
    Text[txt[\"T-cycle\", GrayLevel[0.35]], Scaled[{0.75, -0.2}], {0, 0}],
    keyD, letter[\"D\"]},
   Sequence @@ common,
   PlotRange -> {{0.5, 8.5}, {-5.4, 0.45}},
   FrameTicks -> {{Table[tk[k, Superscript[10, If[k < 0, \"\[Minus]\" <> \
ToString[-k], ToString[k]]]], {k, -5, 0}], None},
                  {Table[tk[i, txt[namesD[[i]], col[namesD[[i]]]]], {i, \
Length[namesD]}], None}},
   FrameLabel -> {{Row[{dOmega, \" \", units[\"\"]}], None}, {None, None}}]\
\>", "Input",
 CellLabel->"In[49]:=",ExpressionUUID->"d9305b37-7b26-4be2-b0da-bb13bbede701"],

