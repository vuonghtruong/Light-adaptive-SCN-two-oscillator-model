Notebook[{

Cell[CellGroupData[{
Cell["Figure S7. Loss of synchrony between D and V in culture", "Title",ExpressionUUID->"62c3a8f7-04fd-44fb-a527-059df84e94e6"],

Cell["\<\
Data: CSV files beside this notebook, written by dephasing.py of the revision \
build (period-adaptive and coupling-adaptive models, DD days 0 to 7 without \
X, forward Euler step 1/64 h, sampled every 0.25 h). Evaluate the notebook \
(Evaluation > Evaluate Notebook). Each panel and the figure appear below, and \
Figure_S7.pdf and Figure_S7.png (600 dpi) are written beside the notebook. \
Solid lines are simulations; dashed lines are least-squares fits of the \
quadratic decay SI(t) = exp(-D_omega t^2/2) (Myung et al., 2012).\
\>", "Text",ExpressionUUID->"388ba210-c803-4b6a-a469-2c17f965a87b"],

Cell[CellGroupData[{

Cell["Style and data", "Section",ExpressionUUID->"65699284-1c5d-4a08-b33c-4252b294dfd6"],

Cell[CellGroupData[{

Cell["\<\
dir = NotebookDirectory[];
font = \"Arial\"; fsLabel = 8; fsTick = 7; fsLetter = 12;
frameStyle = Directive[Black, AbsoluteThickness[0.5]];
(* hyphens stay hyphens: no operator substitution of \"-\" in labels; \
superscripts and subscripts no smaller than 6 pt *)
noSub = PrivateFontOptions -> {\"OperatorSubstitution\" -> False};
tickStyle = Directive[Black, FontFamily -> font, FontSize -> fsTick, \
ScriptMinSize -> 6, noSub];
labelStyle = Directive[Black, FontFamily -> font, FontSize -> fsLabel, \
ScriptMinSize -> 6, noSub];
panelW = 225; panelH = 176; pad = {{48, 8}, {38, 18}};
hex[s_String] := RGBColor @@ (FromDigits[#, 16]/255. & /@ \
StringPartition[StringDrop[s, 1], 2]);
schedules = {\"SP\", \"LD\", \"LP\", \"18:6\", \"T22\", \"T23\", \"T25\", \
\"T26\"};
col = AssociationThread[schedules -> hex /@ {\"#0072B2\", \"#525252\", \
\"#D55E00\", \"#7B3294\", \"#009E73\", \"#56B4E9\", \"#E69F00\", \"#CC79A7\"}];
readTable[file_String] := Module[{raw = Import[FileNameJoin[{dir, file}], \
\"CSV\"]},
   <|\"head\" -> ToString /@ First[raw], \"rows\" -> Rest[raw]|>];
column[t_, name_String] := t[\"rows\"][[All, First@FirstPosition[t[\"head\"], \
name]]];
tA = readTable[\"S7A_period_adaptive_SI.csv\"];
tB = readTable[\"S7B_coupling_adaptive_SI.csv\"];
tC = readTable[\"S7C_dispersion_period_adaptive.csv\"];
tD = readTable[\"S7D_dispersion_by_schedule.csv\"];
tK = readTable[\"S7_constants.csv\"];
constant[name_String] := Pick[column[tK, \"value\"], column[tK, \
\"quantity\"], name][[1]];
perDay = 96; nT = Length[tA[\"rows\"]];
{nT, Dimensions[tC[\"rows\"]], Dimensions[tD[\"rows\"]]}\
\>", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"c6bfc364-9e58-42a8-a72b-2cb435c637f3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"673", ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "4"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"8", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{4.0046311556198473`*^9},
 CellLabel->"Out[21]=",ExpressionUUID->"aab7f78d-d6d2-49b8-adb7-772ef92ddc7b"]
}, Open  ]],

Cell["\<\
(* outward ticks, open frame, Arial *)
tk[pos_, lab_] := {pos, lab, {0, 0.025}};
dayTicks = Table[tk[perDay d, d], {d, 0, 7}];
letter[l_String] := Text[Style[l, Bold, fsLetter, FontFamily -> font, Black], \
Scaled[{-0.22, 1.11}], {-1, 1}];
title[s_String] := Text[Style[s, Bold, fsLabel, FontFamily -> font, Black, \
noSub], Scaled[{0.5, 1.07}], {0, 0}];
txt[s_, c_ : Black] := Style[s, c, fsTick, FontFamily -> font, noSub];
units[pre_] := Row[{\"(\", pre, Superscript[\"rad\", 2], \" \", \
Superscript[\"d\", \"\[Minus]2\"], \")\"}];
dOmega = Subscript[Style[\"D\", Italic], Style[\"\[Omega]\", Italic]];
common = {Frame -> {{True, False}, {True, False}}, Axes -> False, FrameStyle \
-> frameStyle,
   FrameTicksStyle -> tickStyle, LabelStyle -> labelStyle, BaseStyle -> \
labelStyle,
   AspectRatio -> Full, ImageSize -> {panelW, panelH}, ImagePadding -> pad, \
PlotRangeClipping -> False};
simStyle[s_] := Directive[col[s], AbsoluteThickness[1.1]];
fitStyle[s_] := Directive[col[s], AbsoluteThickness[0.7], \
AbsoluteDashing[{2.5, 1.8}]];
seriesPlot[data_List, styles_List] := ListLinePlot[data, DataRange -> {0, nT \
- 1}, PlotStyle -> styles, PlotRange -> All, Sequence @@ common];
lineKey[sty_] := Graphics[{sty, Line[{{0, 0}, {1, 0}}]}, ImageSize -> {14, \
6}, PlotRange -> {{0, 1}, {-1, 1}}, AspectRatio -> Full];
mk[g_] := Graphics[g, ImageSize -> {9, 8}, PlotRange -> {{-1, 1}, {-1, 1}}, \
AspectRatio -> Full];\
\>", "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"72d7b3d4-69d5-4f3e-bddc-b070d004fdbb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["A. Period-adaptive model", "Section",ExpressionUUID->"bf423192-5dc2-43c8-9b9c-c3c6f1c05dd8"],

Cell[CellGroupData[{

Cell["\<\
(* key inside the panel: schedules (photoperiods left, T-cycles right), and \
simulation against the quadratic decay fit *)
keyA = {
   Inset[Grid[Partition[Row[{lineKey[simStyle[#]], \" \", txt[#, col[#]]}] & \
/@ {\"SP\", \"T22\", \"LD\", \"T23\", \"LP\", \"T25\", \"18:6\", \"T26\"}, \
2],
     Alignment -> Left, Spacings -> {1.0, 0.1}], Scaled[{0.04, 0.04}], {Left, \
Bottom}],
   Inset[Grid[{{lineKey[Directive[Black, AbsoluteThickness[1.1]]], \
txt[\"Simulation\"]},
       {lineKey[Directive[Black, AbsoluteThickness[0.7], \
AbsoluteDashing[{2.5, 1.8}]]], txt[\"Quadratic decay fit\"]}},
     Alignment -> {Left, Center}, Spacings -> {0.4, 0.1}], Scaled[{0.04, \
0.36}], {Left, Bottom}]};
pA = Show[
   seriesPlot[Table[column[tA, s <> \"_fit\"], {s, schedules}], fitStyle /@ \
schedules],
   seriesPlot[Table[column[tA, s <> \"_sim\"], {s, schedules}], simStyle /@ \
schedules],
   PlotRange -> {{0, nT - 1}, {0.72, 1.006}},
   FrameTicks -> {{Table[tk[y, ToString@NumberForm[y, {3, 2}]], {y, {0.75, \
0.80, 0.85, 0.90, 0.95, 1.00}}], None}, {dayTicks, None}},
   FrameLabel -> {{\"Sync index\", None}, {\"Days in DD\", None}},
   Epilog -> {letter[\"A\"], title[\"Period-adaptive model\"], keyA}]\
\>", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"c38e9f3f-0261-4950-8baa-0ee2fc1c5d37"],

