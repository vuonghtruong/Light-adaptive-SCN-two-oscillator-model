Cell[CellGroupData[{

Cell["Figure and export", "Section",ExpressionUUID->"1b037fc3-56f0-40d0-ac27-b85755406ed5"],

Cell[CellGroupData[{

Cell["\<\
(* one Graphics of 2 x 225 by 2 x 176 printer points (6.25 by 4.89 in, the \
text width of the SI page);
   Magnification -> 1 keeps the PDF at this size, since PDF export otherwise \
scales the page by 0.72 *)
wF = 2 panelW; hF = 2 panelH;
fig = Graphics[{
    Inset[pA, {0, hF}, {Left, Top}, {panelW, panelH}], Inset[pB, {panelW, \
hF}, {Left, Top}, {panelW, panelH}],
    Inset[pC, {0, panelH}, {Left, Top}, {panelW, panelH}], Inset[pD, {panelW, \
panelH}, {Left, Top}, {panelW, panelH}]},
   PlotRange -> {{0, wF}, {0, hF}}, ImageSize -> {wF, hF}, AspectRatio -> \
hF/wF, ImagePadding -> None, PlotRangePadding -> None];
Export[FileNameJoin[{dir, \"Figure_S7.pdf\"}], Style[fig, Magnification -> 1]];
Export[FileNameJoin[{dir, \"Figure_S7.png\"}], Style[fig, Magnification -> \
1], ImageResolution -> 600];
fig\
\>", "Input",
 CellLabel->"In[59]:=",ExpressionUUID->"69ffd95b-2170-4a87-9936-15314bb7dcf6"],

