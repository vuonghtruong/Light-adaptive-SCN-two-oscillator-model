Cell[CellGroupData[{

Cell["\<\
C. Fitted dispersion against the frequency mismatch (period-adaptive model)\
\>", "Section",ExpressionUUID->"ef3761ca-311d-417f-8b13-5c27fd1ff9f1"],

Cell[CellGroupData[{

Cell["\<\
namesC = ToString /@ column[tC, \"schedule\"];
xC = 1000 column[tC, \"analytic_variance\"]; yI = 1000 column[tC, \
\"D_intact\"]; yU = 1000 column[tC, \"D_uncoupled\"];
ring[p_, c_, r_ : 2.7] := {{c, AbsolutePointSize[2 r], Point[p]}, {White, \
AbsolutePointSize[2 r - 2.2], Point[p]}};
square[p_, c_, s_ : 2.6, filled_ : False] := {EdgeForm[{c, \
AbsoluteThickness[0.9]}], FaceForm[If[filled, c, White]],
    Polygon[{Offset[{-s, -s}, p], Offset[{s, -s}, p], Offset[{s, s}, p], \
Offset[{-s, s}, p]}]};
dot[p_, c_, r_ : 2.7] := {c, AbsolutePointSize[2 r], Point[p]};
pC = Graphics[{
    {GrayLevel[0.6], AbsoluteThickness[0.5], AbsoluteDashing[{2, 2}], \
Line[{{0, 0}, {14, 14}}]},
    Table[{col[namesC[[k]]], AbsoluteThickness[0.5], Line[{{xC[[k]], \
yI[[k]]}, {xC[[k]], yU[[k]]}}]}, {k, Length[namesC]}],
    Table[square[{xC[[k]], yU[[k]]}, col[namesC[[k]]]], {k, Length[namesC]}],
    Table[dot[{xC[[k]], yI[[k]]}, col[namesC[[k]]]], {k, Length[namesC]}],
    Text[txt[\"T26\", col[\"T26\"]], Offset[{-6, 0}, {xC[[8]], yU[[8]]}], {1, \
0}],
    Text[txt[\"T25\", col[\"T25\"]], Offset[{6, 0}, {xC[[7]], yI[[7]]}], {-1, \
0}],
    Text[Row[{Style[\"r\", Italic], \" = \", \
ToString@NumberForm[constant[\"pearson_r_intact\"], {4, 3}]}, BaseStyle -> \
{fsTick, FontFamily -> font}],
      Scaled[{0.05, 0.93}], {-1, 0}],
    Inset[Grid[{{mk[dot[{0, 0}, Black]], txt[\"Intact\"]}, {mk[square[{0, 0}, \
Black]], txt[\"Uncoupled\"]}},
       Alignment -> {Left, Center}, Spacings -> {0.3, 0.2}], Scaled[{0.97, \
0.05}], {Right, Bottom}],
    letter[\"C\"]},
   Sequence @@ common,
   PlotRange -> {{-0.6, 14}, {-0.9, 18}},
   FrameTicks -> {{Table[tk[y, y], {y, 0, 15, 5}], None}, {Table[tk[x, x], \
{x, 0, 10, 5}], None}},
   FrameLabel -> {{Row[{\"Fitted \", dOmega, \" \", \
units[Row[{Superscript[10, \"\[Minus]3\"], \" \"}]]}], None},
                  {Row[{\"Analytic variance \", units[Row[{Superscript[10, \"\
\[Minus]3\"], \" \"}]]}], None}}]\
\>", "Input",
 CellLabel->"In[43]:=",ExpressionUUID->"a56205ad-78a0-4430-87f9-6ac98eefd47c"],

