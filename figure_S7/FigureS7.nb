Cell[CellGroupData[{

Cell["B. Coupling-adaptive model", "Section",ExpressionUUID->"25bed52f-06a6-436c-ad1d-3105ff66a55f"],

Cell[CellGroupData[{

Cell["\<\
fitB = Pick[column[tD, \"schedule\"], column[tD, \"fit_drawn_coupling\"], 1];
fitB = ToString /@ fitB;
labB = {
   Text[txt[\"18:6\", col[\"18:6\"]], {1.2 perDay, 0.22}, {-1, 0}],
   Text[txt[\"LP\", col[\"LP\"]], {5.5 perDay, 0.42}, {-1, 0}],
   Text[txt[\"T22\", col[\"T22\"]], {6.95 perDay, 0.92}, {1, 0}],
   Text[Row[Riffle[txt[#, col[#]] & /@ {\"SP\", \"LD\", \"T23\", \"T25\", \
\"T26\"}, txt[\", \"]]], {6.95 perDay, 0.62}, {1, 0}],
   {GrayLevel[0.6], AbsoluteThickness[0.4], Line[{{5.9 perDay, 0.665}, {5.9 \
perDay, 0.985}}]}};
pB = Show[
   seriesPlot[Table[column[tB, s <> \"_fit\"], {s, fitB}], fitStyle /@ fitB],
   seriesPlot[Table[column[tB, s <> \"_sim\"], {s, schedules}], simStyle /@ \
schedules],
   PlotRange -> {{0, nT - 1}, {-0.02, 1.03}},
   FrameTicks -> {{{tk[0, \"0\"], tk[0.2, \"0.2\"], tk[0.4, \"0.4\"], tk[0.6, \
\"0.6\"], tk[0.8, \"0.8\"], tk[1, \"1\"]}, None}, {dayTicks, None}},
   FrameLabel -> {{\"Sync index\", None}, {\"Days in DD\", None}},
   Epilog -> {letter[\"B\"], title[\"Coupling-adaptive model\"], labB}]\
\>", "Input",
 CellLabel->"In[39]:=",ExpressionUUID->"f28ee295-a301-4dfd-b724-cceba7b67d93"],

